# Copia este archivo a .env y completa los valores.

# Base de datos. En desarrollo: SQLite local.
# En producción (Supabase/PostgreSQL): postgresql://USER:PASSWORD@HOST:PORT/DB
DATABASE_URL="file:./dev.db"

# Secreto de NextAuth (genera uno con: npx auth secret  — o  openssl rand -base64 32)
AUTH_SECRET="cambia-esto-por-un-secreto-aleatorio-largo"

# Permite a NextAuth confiar en el host (necesario detrás de proxies / en local)
AUTH_TRUST_HOST=true
